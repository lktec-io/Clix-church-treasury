# ==================================================================
# Clix Church Treasury Management System — frontend environment
#
# Vite only exposes variables prefixed VITE_ to client code. Copy this
# file to `.env.local` for local development (Vite convention — see
# .gitignore). No secrets belong here: everything in a Vite env var is
# bundled into the public JS output and visible to anyone using the app.
# ==================================================================

# Local development (server/ running on its default port):
#   VITE_API_BASE_URL=http://localhost:4005/api/v1
#
# Production — same origin as the frontend itself, since Nginx routes
# /api/* to the backend and everything else to this app's build output
# (docs/API_ARCHITECTURE.md §Production). The one and only production
# domain for this product (docs/PROJECT_ARCHITECTURE.md) — never
# localhost/127.0.0.1/example.com/an old Clix project domain:
#   VITE_API_BASE_URL=https://treasurer.clixworks.co.tz/api/v1
VITE_API_BASE_URL=http://localhost:4005/api/v1
