# ==================================================================
# Clix Church Treasury Management System — LOCAL DEVELOPMENT environment
#
# Vite only exposes variables prefixed VITE_ to client code. Copy this
# file to `.env.local` for local development (Vite convention — see
# .gitignore). No secrets belong here: everything in a Vite env var is
# bundled into the public JS output and visible to anyone using the app.
#
# This file is for LOCAL DEV only. Production does not read this file or
# depend on anyone copying it — the production API URL lives in the
# separate, already-committed `.env.production` (repo root), which Vite
# loads automatically for every `vite build` regardless of how the build
# command is invoked. Do not put the production URL here as the intent;
# `.env.production` is the actual source of truth for a real deploy.
# ==================================================================

# Local development (server/ running on its default port):
VITE_API_BASE_URL=http://localhost:4005/api/v1
