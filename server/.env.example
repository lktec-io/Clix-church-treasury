# ==================================================================
# Clix Church Treasury Management System — server environment
#
# Copy this file to `.env` for local development, or to `server/.env` on
# the production host. Every value below is a placeholder — this file is
# committed to git and must NEVER contain a real secret
# (docs/DEVELOPMENT_RULES.md §3). PM2 does not inject secrets either (see
# ecosystem.config.cjs) — this .env file, populated directly on the host,
# is the one and only source of real configuration in production.
#
# No naming here was invented for this pass — every variable below is one
# the running code actually reads (server/src/config/env.js). Notably
# there is no JWT_REFRESH_SECRET: refresh tokens are opaque random values
# (crypto.randomBytes), never JWTs, so there is nothing to sign them with
# (docs/SECURITY_ARCHITECTURE.md §2) — adding one would be a dead variable.
# ==================================================================

# development | test | production
NODE_ENV=development

# Backend port. Production MUST be 4005 (docs/DEPLOYMENT.md,
# deploy/nginx.conf.example proxies to 127.0.0.1:4005) — never hard-coded
# in application code, always read from this variable (server/src/server.js).
PORT=4005

# --- Database ---
# server/src/config/db.js reads exactly these five variables — no other
# DB-related env var exists or is needed.
#
# Local development: a dedicated least-privilege app user, never root —
# see server/scripts/setup-db.example.sql.
#   DB_HOST=localhost
#   DB_USER=clix_app
#   DB_NAME=clix_treasury_dev
#
# Production (this deployment's actual requirement — see
# server/scripts/setup-db.production.example.sql and docs/DEPLOYMENT.md):
#   DB_HOST=localhost          (MySQL runs on the same VPS as the app)
#   DB_USER=root               (see docs/DEPLOYMENT.md for the restricted-
#                                user recommendation this deployment
#                                intentionally does not use)
#   DB_NAME=treasurer
#   DB_PASSWORD=<entered manually on the server, never here>
DB_HOST=localhost
DB_PORT=3306
DB_USER=clix_app
DB_PASSWORD=
DB_NAME=clix_treasury_dev
# Only read when NODE_ENV=test (server/src/config/env.js) — a separate
# database so the test suite never touches dev data.
DB_NAME_TEST=clix_treasury_test
DB_CONNECTION_LIMIT=10

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT generated value per environment — never reuse a dev
# secret in production (docs/SECURITY_ARCHITECTURE.md). Must be at least
# 32 characters or the server refuses to start (Phase 11 hardening).
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# --- Public URLs ---
# The frontend origin this API trusts for CORS + cookie-based requests,
# and the base URL used when a response needs to reference the app.
#
# Local development:
#   FRONTEND_URL=http://localhost:5173
#   CORS_ORIGINS=http://localhost:5173
#
# Production (docs/PROJECT_ARCHITECTURE.md — the one and only production
# domain for this product; never localhost/127.0.0.1/example.com/an old
# Clix project domain here):
#   FRONTEND_URL=https://treasurer.clixworks.co.tz
#   CORS_ORIGINS=https://treasurer.clixworks.co.tz
#
# Frontend and API share the same origin in production (Nginx routes
# /api/* to this server, everything else to the built frontend — see
# docs/API_ARCHITECTURE.md §Production). CORS_ORIGINS is still set
# correctly regardless, as defense-in-depth and for any future
# non-browser or separate-origin client.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- SMS (Beem Africa) ---
# Optional. Leave all three blank to run with SMS sending disabled — every
# attempt (member registration, contribution confirmation, monthly
# statement) still gets recorded in sms_log with status
# 'skipped_no_provider', never faked as sent. Set all three to enable real
# delivery via Beem Africa (server/src/modules/sms/providers/beemProvider.js).
# Never commit real values here — this file stays a placeholder template.
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=
# Beem's default send endpoint — override only if Beem tells you to.
BEEM_API_URL=https://apisms.beem.africa/v1/send
