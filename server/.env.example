# ==================================================================
# Clix Church Treasury Management System — server environment
#
# Copy this file to `.env` for local development. Every value below is a
# placeholder — this file is committed to git and must NEVER contain a
# real secret (docs/DEVELOPMENT_RULES.md §3). Production values are
# injected directly into the server's environment at deploy time (e.g.
# via PM2's ecosystem config or the hosting platform's secret manager) —
# never by editing this file or pasting secrets into source control.
# ==================================================================

# development | test | production
NODE_ENV=development
PORT=4000

# --- Database ---
# Local dev: a dedicated least-privilege app user, never root — see
# server/scripts/setup-db.example.sql. Production: the same shape,
# pointing at the production MySQL instance, injected at deploy time.
DB_HOST=localhost
DB_PORT=3306
DB_USER=clix_app
DB_PASSWORD=
DB_NAME=clix_treasury_dev
DB_NAME_TEST=clix_treasury_test
DB_CONNECTION_LIMIT=10

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT generated value per environment — never reuse a dev
# secret in production (docs/SECURITY_ARCHITECTURE.md).
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# --- Public URLs ---
# The frontend origin this API trusts for CORS + cookie-based requests,
# and the base URL used when a response needs to reference the app (e.g.
# a future password-reset email link, Phase 7+).
#
# Local development:
#   FRONTEND_URL=http://localhost:5173
#   CORS_ORIGINS=http://localhost:5173
#
# Production (docs/PROJECT_ARCHITECTURE.md — the one and only production
# domain for this product; never localhost/127.0.0.1/example.com/an old
# Clix project domain here):
#   FRONTEND_URL=https://treasurer.clixworks.co.tz
#   CORS_ORIGINS=https://treasurer.clixworks.co.tz
#
# Frontend and API share the same origin in production (Nginx routes
# /api/* to this server, everything else to the built frontend — see
# docs/API_ARCHITECTURE.md §Production). CORS_ORIGINS is still set
# correctly regardless, as defense-in-depth and for any future
# non-browser or separate-origin client.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
